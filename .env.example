APP_NAME=Kinito
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=kinito
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

#--------------------------------------------------------------------
# E-MAIL (SMTP) — mesmos nomes do Odara + fallback Laravel
#--------------------------------------------------------------------
# Com SMTP_HOST preenchido: MAIL_MAILER=smtp
# Sem SMTP: MAIL_MAILER=log
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS=noreply@kinito.test
MAIL_FROM_NAME="${APP_NAME}"
# Alias Odara (opcional): MAIL_FROM sobrescreve MAIL_FROM_ADDRESS
# MAIL_FROM=noreply@seu-dominio.com

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_CRYPTO=tls

# Fallback Laravel (usados se SMTP_* estiver vazio)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000

PAYMENT_PROVIDER=manual

# Billing SaaS (assinatura de planos) — auto usa Stripe se STRIPE_SECRET, senão mock
BILLING_DRIVER=auto
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_FEE_PERCENT=3.9
STRIPE_FEE_FIXED=0.50

PLATFORM_COMMISSION_PERCENT=15
COMPANY_COMMISSION_PERCENT=10
RIDE_DETAIL_LOG_RETENTION_DAYS=90
KINITO_DEFAULT_PLAN=starter

#--------------------------------------------------------------------
# WHATSAPP — provider pluggable: log | baileys | meta
# Sidecar: pasta whatsapp-gateway/ (npm start → :3001)
#--------------------------------------------------------------------
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=log

# Baileys sidecar (whatsapp-gateway/)
# GATEWAY_API_KEY do gateway deve bater com WHATSAPP_GATEWAY_API_KEY
WHATSAPP_GATEWAY_URL=http://127.0.0.1:3001
WHATSAPP_GATEWAY_API_KEY=kinito-gateway-dev
WHATSAPP_GATEWAY_TIMEOUT=20

# Meta Cloud API (quando pagar a API oficial)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
WHATSAPP_META_GRAPH_VERSION=v21.0
WHATSAPP_META_TIMEOUT=15
