# Kinito WhatsApp Gateway (Baileys — Node.js 20+)
WHATSAPP_GATEWAY_PORT=3001

# Must match WHATSAPP_GATEWAY_API_KEY in Laravel .env
GATEWAY_API_KEY=kinito-gateway-dev

# Laravel inbound webhook (gateway forwards messages here)
LARAVEL_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhooks/whatsapp
# LARAVEL_WEBHOOK_URL=https://api.seudominio.com/api/v1/webhooks/whatsapp

# Tick: pergunta ao backend por trabalho agendado (fila de envio).
# Padrão: LARAVEL_WEBHOOK_URL + /tick
# BACKEND_TICK_URL=
TICK_INTERVAL_MS=30000

# Encrypt Baileys session files at rest (generate: openssl rand -hex 32)
WHATSAPP_SESSION_ENCRYPTION_KEY=

# Optional: override sessions directory (default: whatsapp-gateway/sessions)
# WHATSAPP_SESSIONS_DIR=
